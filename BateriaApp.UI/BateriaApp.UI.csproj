<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BateriaApp.UI</RootNamespace>
    <AssemblyName>BateriaApp.UI</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      La solución apunta a net8.0 (LTS) para poder abrirse tanto en Visual Studio 2022
      como en versiones posteriores. RollForward permite que el ejecutable se inicie
      también sobre runtimes más nuevos (por ejemplo .NET 10) cuando el runtime 8.0
      no está instalado en la máquina.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BateriaApp.BLL\BateriaApp.BLL.csproj" />
    <ProjectReference Include="..\BateriaApp.Domain\BateriaApp.Domain.csproj" />
  </ItemGroup>

</Project>
