<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BateriaApp.UI</RootNamespace>
    <AssemblyName>BateriaApp.UI</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Apunta a net8.0 para que abra en Visual Studio 2022 y posteriores. -->
    <!-- RollForward hace que tambien arranque en runtimes mas nuevos, como .NET 10. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BateriaApp.BLL\BateriaApp.BLL.csproj" />
    <ProjectReference Include="..\BateriaApp.Domain\BateriaApp.Domain.csproj" />
  </ItemGroup>

</Project>
